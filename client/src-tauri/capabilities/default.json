{
  "identifier": "default",
  "description": "Local database, HTTP to the catalogue and rating sources, opening links in other apps",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://apis.justwatch.com/*" },
        { "url": "https://datasets.imdbws.com/*" },
        { "url": "https://api.themoviedb.org/*" },
        { "url": "https://api.tvmaze.com/*" },
        { "url": "https://www.omdbapi.com/*" },
        { "url": "https://api.mdblist.com/*" },
        { "url": "https://www.csfd.cz/*" },
        { "url": "https://api.github.com/*" }
      ]
    }
  ]
}
