<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- no REQUEST_INSTALL_PACKAGES: updates are downloaded in the browser and installed by the system
         (an app that installs APKs itself is treated as suspicious by Play Protect) -->
    <!-- a running synchronisation continues when the app is left (foreground service + notification) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 17 (target SDK 37): the user's own Emby/Jellyfin/Plex at home is unreachable without it -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application>
        <service
            android:name="com.plugin.apk_updater.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
