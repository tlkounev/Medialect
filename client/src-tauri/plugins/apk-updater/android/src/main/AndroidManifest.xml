<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- no REQUEST_INSTALL_PACKAGES: updates are downloaded in the browser and installed by the system
         (an app that installs APKs itself is treated as suspicious by Play Protect) -->
    <!-- a running synchronisation continues when the app is left (foreground service + notification) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 17 (target SDK 37): the user's own Emby/Jellyfin/Plex at home is unreachable without it -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- a streaming link nothing can open (a TV): the service's own app is looked up among the installed
         launcher apps, which Android 11+ shows to an app only when it declares this -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>
    <application>
        <service
            android:name="com.plugin.apk_updater.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
